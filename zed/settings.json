// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "disable_ai": true,
  "toolbar": {
    "agent_review": false
  },
  "agent": {
    "flexible": true,
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "sticky_scroll": {
    "enabled": false
  },
  "scrollbar": {
    "show": "never"
  },
  "terminal": {
    "scrollbar": {
      "show": "auto"
    }
  },
  "cursor_animation": {
    "enabled": true,
  },
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "session": {
    "trust_all_worktrees": true,
  },
  "file_types": {
    "Hyprlang": [
      "conf"
    ]
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "One Dark",
  "experimental.theme_overrides": {
      "background.appearance": "blurred",
      "background": "#00000050",
      "editor.background": "#00000050",
      "editor.gutter.background": "#00000050",
      "tab_bar.background": "#00000050",
      "terminal.background": "#00000050",
      "toolbar.background": "#00000050",
      "tab.active_background": "#00000050",
      "tab.inactive_background": "#00000050",
      "status_bar.background":"#00000050",
      "title_bar.background":"#00000050",
      "panel.background": "#00000050",
      "border.variant": "#00000050",
      "scrollbar.track.border": "#00000050",
      "editor.active_line.background": "#00000050",
    }

}
